<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<Frame name="ForeverDungeonMapBossPinTemplate" mixin="ForeverDungeonMapBossPinMixin" enableMouse="true" virtual="true">
		<Size x="26" y="26"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" file="Interface\TargetingFrame\UI-TargetingFrame-Skull" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Number" inherits="NumberFontNormal">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="5" y="-3"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Check" atlas="common-icon-checkmark" hidden="true">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="5" y="4"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

	<Frame name="ForeverDungeonMapYouPinTemplate" mixin="ForeverDungeonMapYouPinMixin" enableMouse="true" virtual="true">
		<Size x="20" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Ring" file="Interface\COMMON\Indicator-Yellow" alpha="0">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Dot" file="Interface\COMMON\Indicator-Yellow">
					<Size x="18" y="18"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="Pulse" looping="REPEAT">
				<Scale childKey="Ring" scaleX="2.4" scaleY="2.4" duration="1.2" order="1"/>
				<Alpha childKey="Ring" fromAlpha="0.9" toAlpha="0" duration="1.2" order="1"/>
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Frame>
</Ui>
